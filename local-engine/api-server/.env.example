# Manual-setup template. If you used ./install.sh, this file was already
# generated for you (with real secrets) at api-server/.env — you don't
# need this one. This file exists for people setting up by hand; see the
# top-level README's "Manual setup" section for how each block is used.

REDIS_URL=redis://redis:6379
REDIS_BUILDER_URL=redis://redis-builder:6379
DATABASE_URL=postgresql://dreamer:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/dreamer

# ── Local build/run engine ───────────────────────────────────────────────
# Image tag `docker build -t dreamer-build-engine:local ./build-engine`
# produces — DockerDeploymentEngine's launchBuildTask runs this on-demand
# per build.
DOCKER_BUILD_ENGINE_IMAGE=dreamer-build-engine:local
# Must match docker-compose.yml's networks.default.name.
DOCKER_NETWORK=dreamer-local

# ── S3-compatible storage (MinIO) ────────────────────────────────────────
# These are your MinIO credentials, not real AWS ones — @aws-sdk/client-s3
# is just the client library, MinIO speaks the same protocol.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_MINIO_ROOT_USER
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_MINIO_ROOT_PASSWORD
S3_ENDPOINT_URL=http://minio:9000
S3_FORCE_PATH_STYLE=true
S3_BUCKET=dreamer-outputs

# Server
NODE_ENV=production
PORT=8000
FRONTEND_URL=https://REPLACE_WITH_YOUR_DOMAIN
# COOKIE_DOMAIN=.yourdomain.com   # see env.ts's comment — strongly recommended once you have a real domain
# CORS_EXTRA_ORIGINS=
# CORS_ORIGIN_REGEX=

# Auth: JWT — generate each with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Auth: encryption for GitHub tokens at rest — must be exactly 64 hex chars
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# GitHub App — see the top-level README's "Create a GitHub App" section
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# This api-server's own publicly reachable origin — GitHub needs to reach
# both /api/webhooks/github and /api/github-app/callback on it.
API_PUBLIC_URL=https://api.REPLACE_WITH_YOUR_DOMAIN
BASE_DOMAIN=REPLACE_WITH_YOUR_DOMAIN

# Auth: transactional email (verify-email / reset-password links) — REQUIRED,
# api-server refuses to boot without it. See the top-level README's
# "Create a Resend account" section.
RESEND_API_KEY=
EMAIL_FROM="Dreamer <dreamer@REPLACE_WITH_YOUR_DOMAIN>"

# Optional: automatic TLS for custom domains users add to their own
# projects, via Render's Custom Domains API. Unrelated to this stack's
# own TLS (that's install.sh + certbot). Leave blank — custom domains
# still work over plain HTTP without this, TLS is just left manual.
# RENDER_API_KEY=
# RENDER_SERVICE_ID=
